# Скопируйте в backend/deploy/.env и заполните. Файл .env не коммитим.
# Пароли и секреты: openssl rand -hex 24 (только буквы и цифры — пароль идёт в строку подключения).

# Домен для HTTPS. Без своего домена: IP сервера через дефис + .sslip.io, например 1-2-3-4.sslip.io
DOMAIN=

POSTGRES_PASSWORD=
# Ключ подписи входа, не короче 32 символов
JWT_SECRET=

# Ключ Groq (gsk_…) или OpenAI. Без ключа вопросы остаются «ждут проверки ИИ».
OPENAI_API_KEY=
# Groq; для OpenAI — https://api.openai.com/v1
OPENAI_ENDPOINT=https://api.groq.com/openai/v1

# Администратор создаётся при первом запуске
ADMIN_EMAIL=
ADMIN_PASSWORD=
