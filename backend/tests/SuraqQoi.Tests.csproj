<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.23" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- API собран с EF Core 9.0.23 (через Design), а Npgsql тянет 9.0.1 — выравниваем. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SuraqQoi.Api.csproj" />
    <Content Include="heuristic-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="grading-eval/dataset.json;grading-eval/labels.csv" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
